{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "title": "EcoSpecFieldConfig",
  "type": "object",
  "properties": {
    "projectName": {
      "type": "string",
      "description": "Name of the ecological monitoring campaign"
    },
    "samplingFrequencyHz": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100,
      "description": "Sensor telemetry sampling frequency in Hz"
    },
    "deploymentDurationDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "description": "Field deployment window in days"
    },
    "targetSpecies": {
      "type": "string",
      "enum": ["Avian Migration", "Large Mammals", "Marine Telemetry", "Behavioral Ethology"]
    }
  },
  "required": ["projectName", "samplingFrequencyHz", "deploymentDurationDays", "targetSpecies"]
}
