{
  "name": "config",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/config/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:config", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/config",
        "main": "libs/config/src/index.ts",
        "tsConfig": "libs/config/tsconfig.lib.json",
        "additionalEntryPoints": [
          "libs/config/src/api/index.ts",
          "libs/config/src/carto/index.ts",
          "libs/config/src/worker/index.ts"
        ],
        "generateExportsField": true,
        "assets": []
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
